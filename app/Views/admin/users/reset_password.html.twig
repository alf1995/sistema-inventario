{% extends 'layouts/admin.html.twig' %}

{% block content %}
<div class="page-header">
    <div>
        <h1>Restablecer contraseña</h1>
        <p>Usuario objetivo: <strong>{{ user.username }}</strong></p>
    </div>
</div>

<section class="card card-narrow">
    <div class="alert alert-info">
        Esta es una acción sensible. Debes confirmar tu propia contraseña de administrador. Al completarse, se cerrarán todas las sesiones del usuario objetivo.
    </div>

    <form method="post" action="{{ site_url('admin/users/' ~ user.id ~ '/password') }}" autocomplete="off">
        {{ csrf_field() }}

        <div class="form-stack">
            <div class="field">
                <label for="admin_current_password">Tu contraseña actual</label>
                <input id="admin_current_password" name="admin_current_password" type="password" required maxlength="{{ authPasswordVerificationMaxLength }}" autocomplete="current-password">
            </div>

            <div class="field">
                <label for="new_password">Nueva contraseña para {{ user.username }}</label>
                <input id="new_password" name="new_password" type="password" required minlength="{{ authPasswordMinLength }}" maxlength="{{ authPasswordMaxLength }}" autocomplete="new-password">
                <span class="help">{{ authPasswordPolicyHelp }}</span>
            </div>

            <div class="field">
                <label for="new_password_confirm">Confirmar nueva contraseña</label>
                <input id="new_password_confirm" name="new_password_confirm" type="password" required minlength="{{ authPasswordMinLength }}" maxlength="{{ authPasswordMaxLength }}" autocomplete="new-password">
            </div>

            <div class="actions">
                <button class="btn" type="submit">Restablecer contraseña</button>
                <a class="btn btn-secondary" href="{{ site_url('admin/users') }}">Cancelar</a>
            </div>
        </div>
    </form>
</section>
{% endblock %}
