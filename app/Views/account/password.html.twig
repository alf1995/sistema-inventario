{% extends 'layouts/admin.html.twig' %}

{% block content %}
<div class="page-header">
    <div>
        <h1>Cambiar mi contraseña</h1>
        <p>Por seguridad debes confirmar tu contraseña actual antes de definir una nueva.</p>
    </div>
</div>

<section class="card card-narrow">
    <form method="post" action="{{ site_url(authPaths.password) }}" autocomplete="off">
        {{ csrf_field() }}

        <div class="form-stack">
            <div class="field">
                <label for="current_password">Contraseña actual</label>
                <input id="current_password" name="current_password" type="password" required maxlength="{{ authPasswordVerificationMaxLength }}" autocomplete="current-password">
            </div>

            <div class="field">
                <label for="new_password">Nueva contraseña</label>
                <input id="new_password" name="new_password" type="password" required minlength="{{ authPasswordMinLength }}" maxlength="{{ authPasswordMaxLength }}" autocomplete="new-password">
                <span class="help">{{ authPasswordPolicyHelp }}</span>
            </div>

            <div class="field">
                <label for="new_password_confirm">Confirmar nueva contraseña</label>
                <input id="new_password_confirm" name="new_password_confirm" type="password" required minlength="{{ authPasswordMinLength }}" maxlength="{{ authPasswordMaxLength }}" autocomplete="new-password">
            </div>

            <div class="alert alert-info">
                Al cambiar la contraseña se cerrarán tus otras sesiones activas. La sesión actual se mantiene.
            </div>

            <div class="actions">
                <button class="btn" type="submit">Actualizar contraseña</button>
                <a class="btn btn-secondary" href="{{ site_url(authPaths.dashboard) }}">Cancelar</a>
            </div>
        </div>
    </form>
</section>
{% endblock %}
