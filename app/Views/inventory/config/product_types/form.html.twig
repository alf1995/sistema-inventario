{% extends 'layouts/admin.html.twig' %}

{% block content %}
{% set isEdit = mode == 'edit' %}
{% set old = flash('old_form') ?? {} %}
{% set id = isEdit ? item.id : 0 %}
{% set name = old.name ?? (item.name ?? '') %}
{% set description = old.description ?? (item.description ?? '') %}
{% set status = old.status ?? (item.status ?? 'active') %}

<div class="page-header">
    <div>
        <h1>{{ isEdit ? 'Editar tipo de producto' : 'Nuevo tipo de producto' }}</h1>
        <p>Define una presentación reutilizable para el catálogo de productos.</p>
    </div>
</div>

<section class="card card-narrow">
    <form method="post" action="{{ isEdit ? site_url('settings/product-types/' ~ id) : site_url('settings/product-types') }}">
        {{ csrf_field() }}

        <div class="form-stack">
            <div class="field">
                <label for="name">Nombre</label>
                <input id="name" name="name" value="{{ name }}" maxlength="100" required>
            </div>

            <div class="field">
                <label for="description">Descripción</label>
                <textarea id="description" name="description" maxlength="500">{{ description }}</textarea>
            </div>

            <div class="field">
                <label for="status">Estado</label>
                <select id="status" name="status" required>
                    <option value="active" {{ status == 'active' ? 'selected' : '' }}>Activo</option>
                    <option value="inactive" {{ status == 'inactive' ? 'selected' : '' }}>Inactivo</option>
                </select>
            </div>
        </div>

        <div class="actions form-actions">
            <button class="btn" type="submit">{{ isEdit ? 'Guardar cambios' : 'Crear tipo' }}</button>
            <a class="btn btn-secondary" href="{{ site_url('settings/product-types') }}">Cancelar</a>
        </div>
    </form>
</section>
{% endblock %}
