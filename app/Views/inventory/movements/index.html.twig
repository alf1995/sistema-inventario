{% extends 'layouts/admin.html.twig' %}

{% block content %}
<div class="page-header">
    <div>
        <h1>Movimientos de inventario</h1>
        <p>Consulta los ingresos y salidas confirmados en el kardex.</p>
    </div>

    {% if auth_can('movements', 'create') %}
        <a class="btn" href="{{ site_url('movements/create') }}">Registrar movimiento</a>
    {% endif %}
</div>

<section class="card">
    {% include 'partials/admin/table_search.html.twig' with {
        action: site_url('movements'),
        clearUrl: site_url('movements'),
        search: search,
        placeholder: 'Buscar producto, tipo, usuario u observación...'
    } %}

    <div class="table-wrap">
        <table>
            <thead>
            <tr>
                <th>Fecha y hora</th>
                <th>Producto</th>
                <th>Operación</th>
                <th>Tipo</th>
                <th>Cantidad</th>
                <th>Stock anterior</th>
                <th>Stock resultante</th>
                <th>Usuario</th>
                <th>Observación</th>
            </tr>
            </thead>
            <tbody>
            {% if movements is empty %}
                <tr><td colspan="9" class="empty-state">No hay movimientos que coincidan con la búsqueda.</td></tr>
            {% endif %}

            {% for movement in movements %}
                <tr>
                    <td>{{ movement.movement_at }}</td>
                    <td><strong>{{ movement.product_name }}</strong></td>
                    <td>
                        <span class="badge {{ movement.direction == 'IN' ? 'badge-ok' : 'badge-off' }}">
                            {{ movement.direction == 'IN' ? 'Ingreso' : 'Salida' }}
                        </span>
                    </td>
                    <td>{{ movement.movement_type_name }}</td>
                    <td>{{ movement.quantity|number_format }}</td>
                    <td>{{ movement.stock_before|number_format }}</td>
                    <td><strong>{{ movement.stock_after|number_format }}</strong></td>
                    <td>{{ movement.username }}</td>
                    <td>{{ movement.note|default('') }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'partials/admin/pagination.html.twig' %}
</section>
{% endblock %}
