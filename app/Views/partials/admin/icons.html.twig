{% macro icon(name, className) %}
    {% set className = className|default('icon') %}
    {% if name == 'dashboard' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 13h6V4H4v9Zm0 7h6v-4H4v4Zm10 0h6v-9h-6v9Zm0-16v4h6V4h-6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
    {% elseif name == 'products' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m4 7 8-4 8 4-8 4-8-4Zm0 0v10l8 4 8-4V7M12 11v10" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
    {% elseif name == 'movements' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 7h12m0 0-3-3m3 3-3 3M17 17H5m0 0 3 3m-3-3 3-3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif name == 'stock' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 5h14v14H5V5Zm3 4h8M8 12h8M8 15h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif name == 'reports' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 3h9l3 3v15H6V3Zm9 0v4h4M9 11h6M9 15h6M9 19h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif name == 'settings' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z" stroke="currentColor" stroke-width="1.8"/><path d="m19 13.5 1.5 1.2-2 3.4-1.9-.7a7.9 7.9 0 0 1-2.1 1.2l-.3 2H10l-.3-2a7.9 7.9 0 0 1-2.1-1.2l-1.9.7-2-3.4L5 13.5a8.5 8.5 0 0 1 0-3L3.6 9.3l2-3.4 1.9.7a7.9 7.9 0 0 1 2.1-1.2l.3-2h4.2l.3 2a7.9 7.9 0 0 1 2.1 1.2l1.9-.7 2 3.4-1.5 1.2a8.5 8.5 0 0 1 .1 3Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
    {% elseif name == 'users' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7-1a3 3 0 1 0 0-6M3 21v-2a6 6 0 0 1 12 0v2m2-7a5 5 0 0 1 4 5v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    {% elseif name == 'roles' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 4 6v5c0 5.2 3.4 8.5 8 10 4.6-1.5 8-4.8 8-10V6l-8-3Zm-3 9 2 2 4-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif name == 'modules' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 4h6v6H4V4Zm10 0h6v6h-6V4ZM4 14h6v6H4v-6Zm10 0h6v6h-6v-6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
    {% elseif name == 'password' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 10V8a5 5 0 0 1 10 0v2m-11 0h12v11H6V10Zm6 5v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif name == 'search' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="6" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    {% elseif name == 'menu' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    {% elseif name == 'close' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    {% elseif name == 'chevron' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 7 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif name == 'logout' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M10 5H5v14h5M14 8l4 4-4 4m4-4H9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif name == 'box' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m4 7 8-4 8 4v10l-8 4-8-4V7Zm0 0 8 4 8-4M12 11v10" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
    {% elseif name == 'activity' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 12h4l2-6 4 12 2-6h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif name == 'alert' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4 3 20h18L12 4Zm0 5v5m0 3v.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif name == 'arrow-in' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4v13m0 0-5-5m5 5 5-5M5 21h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif name == 'arrow-out' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 20V7m0 0-5 5m5-5 5 5M5 3h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif name == 'clock' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    {% elseif name == 'arrow-right' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif name == 'edit' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 20h4l10.5-10.5a2.12 2.12 0 0 0-3-3L5 17v3Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="m14 8 3 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    {% elseif name == 'delete' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3m-8 0 1 13h8l1-13M10 11v5m4-5v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif name == 'key' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="8" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/><path d="M12 12h8m-3 0v3m-3-3v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif name == 'sessions' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5h16v11H4V5Zm5 15h6M12 16v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="m9 9 6 4m0-4-6 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    {% elseif name == 'download' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% elseif name == 'history' %}
        <svg class="{{ className }}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.3-5.7L4 8.6M4 4v4.6h4.6M12 8v4l3 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {% endif %}
{% endmacro %}
