{% extends 'layouts/auth.html.twig' %}

{% block content %}
<section class="auth-card">
    <div class="auth-heading">
        <h1>PANEL DE ACCESO</h1>
    </div>

    <form method="post" action="{{ site_url(authPaths.login) }}" autocomplete="on">
        {{ csrf_field() }}

        <div class="field">
            <label for="login">Usuario o email</label>
            <input
                id="login"
                name="login"
                type="text"
                maxlength="{{ authLoginIdentifierMaxLength }}"
                value="{{ flash('old_login')|default('') }}"
                autocomplete="username"
                required
                autofocus
            >
        </div>

        <div class="field">
            <label for="password">Contraseña</label>
            <input
                id="password"
                name="password"
                type="password"
                maxlength="{{ authPasswordVerificationMaxLength }}"
                autocomplete="current-password"
                required
            >
        </div>

        <button class="btn btn-block" type="submit">Iniciar sesión</button>
    </form>
</section>
{% endblock %}
