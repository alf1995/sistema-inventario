{
    "name": "inventario/application",
    "description": "Sistema de inventario desarrollado con CodeIgniter 4.7.4",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "laminas/laminas-escaper": "^2.18",
        "phpoffice/phpspreadsheet": "^5.9",
        "psr/log": "^3.0",
        "twig/twig": "3.*"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "kint-php/kint": "^6.1",
        "mikey179/vfsstream": "^1.6.12",
        "phpunit/phpunit": "^10.5.16 || ^11.2"
    },
    "autoload": {
        "psr-4": {
            "CodeIgniter\\": "system/",
            "Config\\": "app/Config/",
            "App\\": "app/",
            "App\\Modules\\": "app/src/Modules/",
            "App\\Shared\\": "app/src/Shared/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**",
            "system/ThirdParty/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "test": "Run PHPUnit tests"
    }
}
